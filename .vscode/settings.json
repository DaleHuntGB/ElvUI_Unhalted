{
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.jj": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        ".vscode": true,
        ".github": true,
        ".pkgmeta": true
    },
    "hide-files.files": [
        ".vscode",
        ".github",
        ".pkgmeta"
    ],
    "Lua.runtime.version": "Lua 5.1",
    "Lua.runtime.builtin": {
        "basic": "disable",
        "debug": "disable",
        "io": "disable",
        "math": "disable",
        "os": "disable",
        "package": "disable",
        "string": "disable",
        "table": "disable",
        "utf8": "disable"
    },
    "Lua.workspace.library": [
        "~/.vscode/extensions/ketho.wow-api-0.22.3/Annotations/Core"
    ],
    "Lua.diagnostics.globals": [
        "TalkingHeadFrame",
        "DELETE_ITEM_CONFIRM_STRING",
        "StaticPopupDialogs",
        "LFGListApplicationDialog",
        "CinematicFrame_CancelCinematic",
        "Add",
        "UIErrorsFrame",
        "ObjectiveTrackerTopBannerFrame",
        "MinimapCluster",
        "Background",
        "RAID_CLASS_COLORS",
        "ACTION_SWING",
        "UNKNOWN",
        "PixelUtil",
        "ScenarioObjectiveTracker",
        "ObjectiveTrackerManager",
        "COMPLETE",
        "ObjectiveTrackerFrame",
        "StaticPopup_Show",
        "CLOSE",
        "WeeklyRewardsUtil",
        "RunNextFrame",
        "CLASS_ICON_TCOORDS",
        "TooltipDataProcessor",
        "INVSLOT_AMMO",
        "BACKPACK_CONTAINER",
        "NUM_BAG_SLOTS"
    ],
    "Lua.type.weakUnionCheck": true
}
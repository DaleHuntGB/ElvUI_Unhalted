{
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        ".vscode": true
    },
    "hide-files.files": [
        ".vscode"
    ],
    "Lua.runtime.version": "Lua 5.1",
    "Lua.runtime.builtin": {
        "basic": "disable",
        "debug": "disable",
        "io": "disable",
        "math": "disable",
        "os": "disable",
        "package": "disable",
        "string": "disable",
        "table": "disable",
        "utf8": "disable"
    },
    "Lua.workspace.library": [
        "~/.vscode/extensions/ketho.wow-api-0.22.3/Annotations/Core"
    ],
    "Lua.diagnostics.globals": [
        "StaticPopup_Show",
        "TalkingHeadFrame",
        "StaticPopupDialogs",
        "ReloadUI",
        "CinematicFrame_CancelCinematic",
        "LossOfControlFrame",
        "NUM_BAG_SLOTS",
        "UIErrorsFrame",
        "ActionStatus",
        "CLOSE",
        "Background",
        "BACKGROUND",
        "GetClassAtlas",
        "DAMAGE",
        "AnchorUtil",
        "MenuVariants",
        "UNKNOWN",
        "DELETE_ITEM_CONFIRM_STRING"
    ],
    "Lua.type.weakUnionCheck": true
}